# LLM Provider Configuration Example
# Copy this file to .env and configure your keys:
# cp .env.example .env

# --- Google Gemini ---
# Set your Google AI Studio API key
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Override the model name (default: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.5-flash

# --- OpenAI (Do not use per instructions) ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# --- Azure OpenAI (Secondary / Fallback) ---
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name_here
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
