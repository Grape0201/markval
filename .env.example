# LLM Provider Configuration Example
# Copy this file to .env and configure your keys:
# cp .env.example .env

# --- LLM Provider Selection ---
# Select primary LLM provider: gemini, openai, or azure (default: gemini)
# LLM_PROVIDER=gemini

# --- Google Gemini ---
# Set your Google AI Studio API key
GEMINI_API_KEY=your_gemini_api_key_here
# Required: Set your Gemini model name (e.g. gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI & OpenAI-Compatible API ---
# Set your OpenAI API key or compatible API key
# OPENAI_API_KEY=your_openai_api_key_here
# Optional: Set API Base URL for compatible services (e.g. Ollama, DeepSeek, LocalAI, vLLM)
# OPENAI_API_BASE=http://localhost:11434/v1
# Required: Set your model name (e.g. gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- Azure OpenAI ---
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
# Required: Set your Azure deployment name
# AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name_here
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
